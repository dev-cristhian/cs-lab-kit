{
  "name": "cs-lab-kit",
  "version": "1.1.0",
  "description": "A utility toolkit for JavaScript and TypeScript — data generators, validators, and more.",
  "keywords": [
    "cpf",
    "cnpj",
    "brazil",
    "brasil",
    "brazilian-documents",
    "document-validator",
    "validator",
    "formatter",
    "generator",
    "sanitizer",
    "parser",
    "uuid",
    "password-generator",
    "base64",
    "jwt-decoder",
    "currency",
    "text-case",
    "camelcase",
    "snake-case",
    "kebab-case",
    "pascal-case",
    "constant-case",
    "title-case",
    "case-converter",
    "string-case",
    "text-transform",
    "remove-accents",
    "diacritics",
    "cep",
    "fake-data",
    "test-data",
    "data-generator",
    "utility",
    "toolkit",
    "utils",
    "typescript",
    "javascript",
    "nodejs",
    "esm",
    "zero-dependencies"
  ],
  "author": "Cristhian Santos",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-cristhian/cs-lab-kit.git"
  },
  "homepage": "https://github.com/dev-cristhian/cs-lab-kit#readme",
  "bugs": {
    "url": "https://github.com/dev-cristhian/cs-lab-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
